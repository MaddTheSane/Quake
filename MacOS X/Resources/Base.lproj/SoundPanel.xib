<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="18122" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="18122"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="QSoundPanel">
            <connections>
                <outlet property="mAudioPopup" destination="33" id="40"/>
                <outlet property="mOpenPanelView" destination="14" id="20"/>
                <outlet property="view" destination="2" id="41"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="2" userLabel="SoundPanel">
            <rect key="frame" x="0.0" y="0.0" width="433" height="92"/>
            <autoresizingMask key="autoresizingMask"/>
            <subviews>
                <box boxType="oldStyle" borderType="none" titlePosition="noTitle" translatesAutoresizingMaskIntoConstraints="NO" id="31">
                    <rect key="frame" x="0.0" y="20" width="433" height="52"/>
                    <view key="contentView" id="Ox8-mW-IHU">
                        <rect key="frame" x="0.0" y="0.0" width="433" height="52"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <popUpButton toolTip="Select the display." horizontalHuggingPriority="249" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="33">
                                <rect key="frame" x="146" y="11" width="274" height="25"/>
                                <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="clipping" borderStyle="borderAndBezel" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="36">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="menu"/>
                                    <menu key="menu" title="OtherViews" id="37">
                                        <items>
                                            <menuItem title="Item1" id="38"/>
                                        </items>
                                    </menu>
                                </popUpButtonCell>
                            </popUpButton>
                            <textField toolTip="Select the display." verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" setsMaxLayoutWidthAtFirstLayout="YES" translatesAutoresizingMaskIntoConstraints="NO" id="34">
                                <rect key="frame" x="13" y="18" width="131" height="16"/>
                                <textFieldCell key="cell" sendsActionOnEndEditing="YES" alignment="right" title="Play audio files from:" id="35">
                                    <font key="font" metaFont="system"/>
                                    <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                        </subviews>
                        <constraints>
                            <constraint firstItem="34" firstAttribute="leading" secondItem="Ox8-mW-IHU" secondAttribute="leading" constant="15" id="7vu-qf-TTZ"/>
                            <constraint firstItem="34" firstAttribute="firstBaseline" secondItem="33" secondAttribute="firstBaseline" id="CIE-6W-gtG"/>
                            <constraint firstItem="33" firstAttribute="leading" secondItem="34" secondAttribute="trailing" constant="7" id="OAG-uJ-osv"/>
                            <constraint firstItem="34" firstAttribute="centerY" secondItem="Ox8-mW-IHU" secondAttribute="centerY" id="YSO-PJ-XbT"/>
                            <constraint firstAttribute="trailing" secondItem="33" secondAttribute="trailing" constant="17" id="ayh-re-sEt"/>
                            <constraint firstItem="34" firstAttribute="baseline" secondItem="33" secondAttribute="baseline" id="njb-uu-4NF"/>
                        </constraints>
                    </view>
                    <font key="titleFont" metaFont="system"/>
                </box>
            </subviews>
            <constraints>
                <constraint firstAttribute="bottom" secondItem="31" secondAttribute="bottom" constant="20" symbolic="YES" id="Nsj-8c-viK"/>
                <constraint firstAttribute="trailing" secondItem="31" secondAttribute="trailing" id="Rck-ds-vMi"/>
                <constraint firstItem="31" firstAttribute="top" secondItem="2" secondAttribute="top" constant="20" symbolic="YES" id="pMj-3U-sZn"/>
                <constraint firstItem="31" firstAttribute="leading" secondItem="2" secondAttribute="leading" id="q6w-82-PqP"/>
            </constraints>
            <point key="canvasLocation" x="14" y="135"/>
        </customView>
        <customView id="13" userLabel="OpenPanelAccessoryView">
            <rect key="frame" x="0.0" y="0.0" width="311" height="42"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" setsMaxLayoutWidthAtFirstLayout="YES" translatesAutoresizingMaskIntoConstraints="NO" id="14">
                    <rect key="frame" x="-3" y="0.0" width="317" height="42"/>
                    <textFieldCell key="cell" sendsActionOnEndEditing="YES" alignment="center" id="15">
                        <font key="font" metaFont="smallSystem"/>
                        <string key="title">Please select a folder that holds audio files. The filenames must end on the extension ".mp3" or ".mp4". Files that are stored in subfolders will be recognized, too.</string>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <constraints>
                <constraint firstItem="14" firstAttribute="top" secondItem="13" secondAttribute="top" id="4hZ-lx-6YH"/>
                <constraint firstItem="14" firstAttribute="centerX" secondItem="13" secondAttribute="centerX" id="7Et-hH-CuV"/>
            </constraints>
            <point key="canvasLocation" x="-65" y="3"/>
        </customView>
    </objects>
</document>
